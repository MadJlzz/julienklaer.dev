---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, toListItem } from '../../lib/posts';

const items = (await getPosts()).map(toListItem);
---
<BaseLayout title="posts" description="all posts">
  <h1 class="section-title">~/posts</h1>
  {items.length === 0
    ? <p class="empty">no posts yet.</p>
    : <PostList items={items} />}
</BaseLayout>

<style>
  .section-title { font-size: 28px; color: var(--accent); margin: 0 0 1rem; }
  .empty { color: var(--fg-dim); }
</style>
