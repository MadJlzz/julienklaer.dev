---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
---
<BaseLayout title="about" description={`about ${SITE.handle}`}>
  <article class="prose">
    <h1>~/about</h1>
    <p>
      Hi, I'm {SITE.author}. This is where I write about
      <span class="tag">code</span>,
      <span class="tag">music</span> and
      <span class="tag">nature</span>
    </p>
    <p>
      Find me elsewhere:
    </p>
    <ul>
      <li><a href={SITE.socials.github}>github</a></li>
      <li><a href="/rss.xml">rss</a></li>
      <li><a href={SITE.socials.twitch}>twitch</a></li>
    </ul>
  </article>
</BaseLayout>
