---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getAllTags, getPostsByTag, toListItem } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const items = (await getPostsByTag(tag)).map(toListItem);
---
<BaseLayout title={`#${tag}`} description={`posts tagged ${tag}`}>
  <h1 class="section-title">#{tag}</h1>
  {items.length === 0
    ? <p class="empty">no posts.</p>
    : <PostList items={items} />}
</BaseLayout>

<style>
  .section-title { font-size: 28px; color: var(--accent); margin: 0 0 1rem; }
  .empty { color: var(--fg-dim); }
</style>
