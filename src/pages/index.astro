---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import { getPosts, toListItem } from '../lib/posts';
import { SITE } from '../site';

const items = (await getPosts()).slice(0, 12).map(toListItem);
---
<BaseLayout>
  <Hero title={SITE.title} subtitle={SITE.description} />

  <section class="latest" aria-labelledby="latest-h">
    <h2 id="latest-h" class="section-h"># latest</h2>
    {items.length === 0
      ? <p class="empty">no posts yet.</p>
      : <PostList items={items} />}
  </section>
</BaseLayout>

<style>
  .section-h {
    color: var(--accent);
    font-size: 15px;
    margin: 0 0 1rem;
  }
  .latest { margin-top: 1rem; }
  .empty { color: var(--fg-dim); }
</style>
