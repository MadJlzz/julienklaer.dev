---
import BaseLayout from './BaseLayout.astro';
import { SITE, type Level } from '../site';

interface Props {
  title: string;
  date: Date;
  level: Level;
  excerpt?: string;
  tags?: string[];
  draft?: boolean;
}
const { title, date, level, excerpt, tags = [], draft = false } = Astro.props;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: date.toISOString(),
  url: canonical,
  author: { '@type': 'Person', name: SITE.author },
  ...(excerpt && { description: excerpt }),
  ...(tags.length > 0 && { keywords: tags.join(', ') }),
};
---
<BaseLayout title={title} description={excerpt}>
  <p class="back"><a href="/posts/">../posts</a></p>
  <article class="prose post-card">
    <h1>{title}</h1>
    <div class="meta-row">
      <span>{fmt(date)}</span>
      <span class={`level level--${level}`}>[{level}]</span>
      {draft && <span class="draft">[draft]</span>}
      {tags.length > 0 && (
        <span class="tag-list">
          {tags.map((t) => <a href={`/tags/${t}/`} class="tag">{t}</a>)}
        </span>
      )}
    </div>
    <slot />
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .back {
    color: var(--fg-dim);
    font-size: 15px;
    max-width: 960px;
    margin: 0 auto 1rem;
  }
  .post-card {
    background: color-mix(in srgb, var(--bg-alt) 94%, var(--fg));
    padding: clamp(2rem, 5vw, 3rem);
    max-width: 960px;
    border-radius: 6px;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--fg) 8%, transparent),
      0 24px 56px -16px rgba(0, 0, 0, 0.7);
  }
  .post-card > :first-child {
    margin-top: 0;
  }
  .level--easy         { color: var(--level-easy); }
  .level--intermediate { color: var(--level-intermediate); }
  .level--advanced     { color: var(--level-advanced); }
  .draft { color: var(--warn); }
  .tag-list { display: inline-flex; flex-wrap: wrap; gap: 0.5rem; }
</style>
