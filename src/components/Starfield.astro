---
import { STARFIELD } from '../starfield.config';
---
<div class="starfield" aria-hidden="true" transition:persist>
  <canvas id="starfield-canvas"></canvas>
</div>

<script is:inline define:vars={{ cfg: STARFIELD }}>
  (() => {
    const canvas = document.getElementById('starfield-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    if (canvas.dataset.running === '1') return;
    canvas.dataset.running = '1';

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let stars = [];
    let raf = 0;
    let lastW = 0;
    let lastH = 0;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);

    const measure = () => {
      const rect = canvas.getBoundingClientRect();
      return { w: Math.round(rect.width), h: Math.round(rect.height) };
    };

    const seed = (w, h) => {
      canvas.width = w * DPR;
      canvas.height = h * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      const count = Math.min(cfg.maxStars, Math.floor((w * h) / cfg.density));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        z: Math.random() * cfg.depthRange + cfg.depthMin,
        v: cfg.speedMin + Math.random() * cfg.speedRange,
        t: Math.random() * Math.PI * 2,
      }));
      lastW = w;
      lastH = h;
    };

    const tick = () => {
      ctx.clearRect(0, 0, lastW, lastH);
      for (const s of stars) {
        s.y -= s.v;
        s.t += cfg.twinkleSpeed;
        if (s.y < -2) { s.y = lastH + 2; s.x = Math.random() * lastW; }
        const tw = 0.6 + Math.sin(s.t) * 0.4;
        const size = s.z < cfg.sizeThreshold ? cfg.sizeSmall : cfg.sizeLarge;
        ctx.fillStyle = `rgba(${cfg.color}, ${s.z * tw})`;
        ctx.fillRect(Math.floor(s.x), Math.floor(s.y), size, size);
      }
      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (reduce.matches) return;
      cancelAnimationFrame(raf);
      const { w, h } = measure();
      if (w === 0 || h === 0) {
        requestAnimationFrame(start);
        return;
      }
      seed(w, h);
      tick();
    };

    const onResize = () => {
      const { w, h } = measure();
      if (w === lastW && h === lastH) return;
      cancelAnimationFrame(raf);
      if (w === 0 || h === 0) return;
      seed(w, h);
      tick();
    };

    start();

    const ro = new ResizeObserver(onResize);
    ro.observe(canvas);

    reduce.addEventListener?.('change', () => {
      cancelAnimationFrame(raf);
      if (!reduce.matches) start();
      else ctx.clearRect(0, 0, lastW, lastH);
    });
  })();
</script>

<style>
  #starfield-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
